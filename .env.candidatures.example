# Copiez en .env.candidatures ou utilisez : python3 -m src.candidatures configure
# Ne collez jamais le token dans une conversation ou un fichier suivi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=
# Les identifiants sont ceux du chat PRIVÉ et de son propriétaire.
CANDIDATURES_ENABLED=true
# Activé seulement après un test réussi de l'accès Chrome hors conversation.
CANDIDATURES_SUBMIT_ENABLED=false
