# Fichier privé : chmod 600 .env
APIFY_TOKEN=
DISCOVERY_CV=/chemin/absolu/vers/cv-confirme.pdf
# Par défaut, état privé sous HOME_DU_PROJET/var.
# DISCOVERY_DATA_DIR=/chemin/absolu/vers/etat
# DISCOVERY_PROMPT_FILE=/chemin/absolu/vers/prompt-versionne.txt
DISCOVERY_PROFILES='["architecte solutions IA","consultant IA","AI engineer"]'
DISCOVERY_LIMIT=100
DISCOVERY_COLLECT_SECONDS=900
DISCOVERY_CODEX_SECONDS=180
DISCOVERY_POLL_SECONDS=5
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=linkedin-discovery-pilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# true : graphe, entrées annonce/CV/prompt et verdicts envoyés à LangSmith.
# false : uniquement les métadonnées techniques historiques.
DISCOVERY_TRACE_CONTENT=false
# Pour le serveur Studio local ; la CLI configure son contexte explicitement.
LANGSMITH_TRACING=false
# Docker local : binaire Linux natif de Codex sur l’hôte.
# GRAPHE1_CODEX_BIN=/chemin/absolu/vers/bin/codex
# Stockage documentaire PostgreSQL partagé (service libpq configuré sur le worker).
# DISCOVERY_POSTGRES_DSN=service=linkedin_discovery
