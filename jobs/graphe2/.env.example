APPLICATIONS_BROWSER_COMMAND='["browsentic","mcp"]'
APPLICATIONS_BROWSER_POLICY=/chemin/prive/actions-browsentic.json
APPLICATIONS_LETTER_TEMPLATE=/chemin/prive/lettre-inwi.docx
APPLICATIONS_HUMANIZER=/chemin/prive/Humanizer/SKILL.md
APPLICATIONS_TELEGRAM_TOKEN=
APPLICATIONS_TELEGRAM_CHAT=
APPLICATIONS_SMTP_HOST=
APPLICATIONS_SMTP_USER=
APPLICATIONS_SMTP_PASSWORD=
APPLICATIONS_IMAP_HOST=
APPLICATIONS_IMAP_SENT=

# Accès SQL du worker, login membre du rôle linkedin_applications
APPLICATIONS_POSTGRES_DSN=
APPLICATIONS_CANDIDATE=

# Port optionnel du collecteur de recette, sur le loopback du worker
APPLICATIONS_TRACE_LOCAL_PORT=

# Clé AES-GCM du coffre de comptes, 32 octets base64 dans un fichier privé.
APPLICATIONS_ACCOUNT_KEY_FILE=

# Tableau JSON de commande stdio du MCP Thunderbird associé à la boîte de recette.
APPLICATIONS_THUNDERBIRD_COMMAND=
# Marqueurs synthétiques des deux espaces du portail hors ligne.
APPLICATIONS_OFFLINE_RECIPE_MARKERS=0
